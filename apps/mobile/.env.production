# Mobile production env — committed so external users can build a personal
# iPhone copy of Patchbay against the same backend as aspectlylabs.com on web.
# Loaded by the `*:prod` scripts via dotenv-cli (see package.json).
EXPO_PUBLIC_API_URL=https://api.aspectlylabs.com
EXPO_PUBLIC_WEB_URL=https://aspectlylabs.com
