# Internal staging environment; not a public support environment.
# Used by `pnpm dev:desktop:staging` (`electron-vite dev --mode staging`).
# Personal overrides go in .env.staging.local.
#
# Canonical URLs: deploy/origin/hosted-environments.json
VITE_API_URL=https://api.staging.aspectlylabs.com
VITE_APP_URL=https://staging.aspectlylabs.com
VITE_ACCOUNTS_URL=https://accounts.staging.aspectlylabs.com
