# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
/bin/

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Rust production binaries embed these crate-owned assets at compile time.
# Re-include them after the repository-wide Markdown ignore.
!server-rs/crates/cordy-service/assets/
!server-rs/crates/cordy-service/assets/**
!server-rs/crates/cordy-handler/assets/
!server-rs/crates/cordy-handler/assets/**

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/

# Repository-only tooling
/.github/
/deploy/
/scripts/
