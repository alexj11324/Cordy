# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
/bin/

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Rust production binaries embed these crate-owned assets at compile time.
# Re-include them after the repository-wide Markdown ignore.
!server-rs/crates/patchbay-service/assets/
!server-rs/crates/patchbay-service/assets/**
!server-rs/crates/patchbay-handler/assets/
!server-rs/crates/patchbay-handler/assets/**

# Default-exclude app workspaces, then opt in only the production image
# contexts maintained by the Dockerfiles in this repository.
/apps/*
!/apps/web/
!/apps/web/**

# The separately released accounts broker has its own production image.
!/apps/auth-broker/
!/apps/auth-broker/**

# The production docs image is built from the exact docs workspace as well.
!/apps/docs/
!/apps/docs/**

# Repository-only tooling
/.github/
/deploy/
/scripts/
