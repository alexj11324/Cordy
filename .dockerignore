# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Rust production binaries embed these narrow Go-owned assets at compile time.
# Re-include them after the repository-wide Markdown ignore.
!server/internal/service/builtin_agents/
!server/internal/service/builtin_agents/**
!server/internal/service/builtin_skills/
!server/internal/service/builtin_skills/**

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/

# Repository-only tooling
/.github/
/deploy/
/scripts/
