# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server-rs/target
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Rust cordy-server, cordy-migrate, and cordy-cli compile cordy-service's
# Go-side assets into the binaries. Keep the narrow source trees in the Docker
# context even though Markdown is excluded elsewhere.
!server/internal/service/builtin_agents/
!server/internal/service/builtin_agents/**
!server/internal/service/builtin_skills/
!server/internal/service/builtin_skills/**

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/

# Repository-only tooling
/.github/
/deploy/
/scripts/
