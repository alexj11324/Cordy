{
  "$schema": "./schema.json",
  "name": "orvilo-auth-broker",
  "version": 1,
  "origins": { "broker": "https://accounts.aspectlylabs.com", "product": "https://orvilo.aspectlylabs.com", "api": "https://api.aspectlylabs.com" },
  "broker": { "googleStartPath": "/oauth/google", "googleCallbackPath": "/oauth/google/callback", "desktopCompletionPath": "/login", "desktopAttemptPath": "/v1/desktop/google/attempt", "desktopCompletePath": "/v1/desktop/google/complete", "contractPath": "/v1/contract" },
  "goApi": { "desktopAttemptPath": "/api/desktop-google/attempt", "desktopCompletePath": "/api/desktop-google/complete", "desktopRedeemPath": "/api/desktop-handoff/redeem", "desktopIdentityRedeemPath": "/api/desktop-identity/redeem" },
  "desktop": { "callbackUrl": "orvilo://auth/callback", "queryParameters": ["code", "state"], "pkceMethod": "S256", "bearerAllowedInCallback": false },
  "client": { "clerkExchangePath": "/auth/clerk", "guestPath": "/auth/guest", "logoutPath": "/auth/logout", "mePath": "/api/me", "websocketPath": "/ws", "guestTokenPrefix": "ovg_", "guestWorkspaceAccess": false, "guestWebsocketAccess": false },
  "authority": { "identity": "clerk", "orviloSession": "go-api", "oneTimeGrant": "go-api", "brokerPersistence": "none" }
}
