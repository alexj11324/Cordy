FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/auth-broker/package.json apps/auth-broker/
COPY packages/eslint-config/package.json packages/eslint-config/
RUN corepack enable && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && corepack prepare "$PNPM_VERSION" --activate
RUN pnpm install --filter @patchbay/auth-broker... --frozen-lockfile

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json ./
RUN corepack enable && PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && corepack prepare "$PNPM_VERSION" --activate
COPY --from=deps /app ./
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/auth-broker/ apps/auth-broker/
COPY contracts/ contracts/
COPY packages/eslint-config/ packages/eslint-config/
RUN pnpm install --filter @patchbay/auth-broker... --frozen-lockfile --offline
RUN rm -f node_modules/.bin/node
ARG NEXT_PUBLIC_APP_VERSION=dev
ARG COMMIT_SHA=unknown
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION NEXT_PUBLIC_COMMIT_SHA=$COMMIT_SHA STANDALONE=true
RUN pnpm --filter @patchbay/auth-broker build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/auth-broker/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/auth-broker/.next/static ./apps/auth-broker/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/auth-broker/public ./apps/auth-broker/public
COPY --chown=nextjs:nodejs LICENSE NOTICE ./
USER nextjs
EXPOSE 3000
CMD ["node", "apps/auth-broker/server.js"]
